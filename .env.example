# Berrova website environment. Copy to `.env` (git-ignored) and fill in.
# Vite only exposes vars prefixed with VITE_ to the client bundle.
# Do NOT put any secret (sk_...) here. This file is client-side only.

# Full URL of the checkout Worker endpoint, including the path.
# Get this after deploying worker/ (see worker/README.md). Production value:
#   https://checkout.berrova.com/create-checkout-session
# Use the Worker's CUSTOM DOMAIN, not the *.workers.dev hostname: consumer
# security suites (Bitdefender, confirmed 2026-07-31) block free-hosting TLDs,
# which kills the checkout fetch with no server-side error to diagnose.
# For local dev against `wrangler dev`, http://127.0.0.1:8787/create-checkout-session
# LEAVE EMPTY until the Worker is live: while empty, the Checkout and Subscribe
# buttons render disabled with a "Checkout opening soon" note, on purpose.
VITE_CHECKOUT_ENDPOINT=

# Stripe PUBLISHABLE key (pk_live_... or pk_test_...). Publishable keys are safe
# to ship to the browser. Optional: only needed if a future flow uses Stripe.js.
# NEVER put a secret key (sk_...) here.
VITE_STRIPE_PK=

# Shared guard token sent to the checkout Worker as the X-Berrova-Guard
# header. Must match the Worker's CHECKOUT_GUARD_TOKEN secret (set there with
# `wrangler secret put CHECKOUT_GUARD_TOKEN`, see worker/README.md).
# HONESTY NOTE: this is a client-side value, bundled into the shipped JS like
# every other VITE_ var, so it is NOT a real secret and is visible to anyone
# who reads the bundle. It only raises the bar above blind/naive scripts that
# hit the known Worker URL with no idea a token is required; it is not strong
# auth and should not be treated as one.
VITE_CHECKOUT_GUARD_TOKEN=
